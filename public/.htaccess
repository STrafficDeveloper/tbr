Options -Indexes

# PHP settings file: never downloadable.
<Files ".user.ini">
    Require all denied
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Strip trailing slashes so /port-rider/ and /port-rider are one URL, not two.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # Everything that is not a real file goes through the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # asset() stamps each file with ?v=<modified time>, so a changed file gets
    # a new URL: the old one can safely be cached for good.
    <If "%{QUERY_STRING} =~ /^v=\d+$/">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # Uploaded images get random names and are never edited in place.
    <If "%{REQUEST_URI} =~ m#^/uploads/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
